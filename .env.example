# NocoBase database. The Router queries only public.v_octop_user_routes.
# The view is already created in nocobase3; do not recreate it during deployment.
NOCOBASE_DATABASE_URL=postgresql://octop_router_nocobase_ro:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/nocobase3?sslmode=verify-full

# Dedicated Octop application registry database; separate DB on same PostgreSQL service is fine.
OCTOP_LDAP_DATABASE_URL=postgresql://octop_router_ldap_ro:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/octop-ldap?sslmode=verify-full

PGCONNECT_TIMEOUT=5

# Must match the public host and Nginx port registrations in octop-ldap.
OCTOP_EXTERNAL_HOST=ai.superice.com
OCTOP_ALLOWED_PORTS=8091,8092,8093,8094,8095,8096,8097,8098,8099,8100

# Employee numbers are normalized to lowercase only. Leading zeroes are preserved.
# DOMAIN\\ prefixes, UPN suffixes and surrounding whitespace are not stripped.
OCTOP_EMPLOYEE_NO_REGEX=^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$
